  "scenarios": [
    {
      "id": "parallel_enquiries",
      "events": [
        "event_enquiry_a",
        "event_enquiry_b",
        "event_booking_a"
      ],
      "expected": "Only sales_a enters the booked stage and stops its booking reminders; sales_b remains independent."
    },
    {
      "id": "duplicate_webhook",
      "events": [
        "event_order_101",
        "event_order_101"
      ],
      "expected": "One accepted delivery/effect; paid gross 149.00 GBP, not 298.00; no repeated local welcome intent."
    },
    {
      "id": "repeated_purchase",
      "events": [
        "event_order_101",
        "event_order_102"
      ],
      "expected": "Two distinct purchase subjects; gross 199.00 GBP. Order 102 has unknown checkout attribution."
    },
    {
      "id": "pending_refund",
      "events": [
        "event_order_101",
        "event_refund_pending"
      ],
      "expected": "Refund is pending; confirmed returned money remains 0.00 GBP."
    },
    {
      "id": "successful_refund",
      "events": [
        "event_order_101",
        "event_refund_pending",
        "event_refund_succeeded"
      ],
      "expected": "Original paid fact is preserved; returned money 149.00 GBP and net 0.00 GBP."
    },
    {
      "id": "same_id_other_owner",
      "input": {
        "ownerId": "customer_beta",
        "sourceId": "beta_shopify",
        "externalOrderId": "gid://shopify/Order/101"
      },
      "expected": "Independent owned fact/subject; never resolves customer_alpha records."
    },
    {
      "id": "browser_payment_claim",
      "input": {
        "sourceId": "browser_source",
        "type": "order.paid"
      },
      "expected": "Reject unsupported authoritative event; no paid fact, transition or send."
    },
    {
      "id": "ambiguous_booking",
      "input": {
        "sourceId": "source_calendly",
        "emailHint": "maya@example.test",
        "journeyReference": null
      },
      "expected": "Retain unmatched booking; email does not select sales_a or sales_b."
    }
