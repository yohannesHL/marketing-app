{
  "private": true,
  "name": "launchpad-monorepo",
  "scripts": {
    "dev": "npm --workspace @launchpad/web run dev",
    "webinstall": "npm --workspace @launchpad/web install",
    "test:e2e:app": "tsx tests/support/start-test-app.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.ts --debug",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:security": "tsx --test tests/integration/*.test.ts",
    "mock:google": "mockoon-cli start --data tests/mockoon/google-ads.json --port 3910 --hostname 127.0.0.1 --disable-admin-api"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@mockoon/cli": "9.9.0",
    "@playwright/test": "^1.54.1",
    "tsx": "^4.23.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
