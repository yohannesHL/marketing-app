{
  "private": true,
  "name": "launchpad-monorepo",
  "scripts": {
    "dev": "npm --workspace @launchpad/web run dev",
    "webinstall": "npm --workspace @launchpad/web install",
    "test:e2e:app": "tsx tests/support/start-test-app.ts",
    "test:e2e": "tsx tests/support/run-app-journeys.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.ts --debug",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:security": "tsx --test tests/integration/*.test.ts",
    "mock:google": "mockoon-cli start --data tests/mockoon/google-ads.json --port 3910 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "mock:youtube": "mockoon-cli start --data tests/mockoon/youtube.json --port 3912 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "mock:tiktok": "mockoon-cli start --data tests/mockoon/tiktok.json --port 3914 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "mock:meta-publishing": "mockoon-cli start --data tests/mockoon/meta-publishing.json --port 3913 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "mock:meta": "mockoon-cli start --data tests/mockoon/meta-ads.json --port 3911 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "pilot:ads:read": "tsx apps/web/scripts/ads-pilot-read.ts",
    "social:worker": "tsx apps/web/scripts/social-worker.ts",
    "mock:linkedin": "mockoon-cli start --data tests/mockoon/linkedin.json --port 3915 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "mock:x": "mockoon-cli start --data tests/mockoon/x.json --port 3916 --hostname 127.0.0.1 --disable-admin-api --disable-log-to-file",
    "test:e2e:delivery": "playwright test --config=playwright.social-delivery.config.ts",
    "test:e2e:delivery-app": "tsx tests/support/start-social-delivery-app.ts",
    "tracking:worker": "tsx apps/web/scripts/tracking-worker.ts",
    "funnels:worker": "tsx apps/web/scripts/funnel-worker.ts",
    "email:worker": "tsx apps/web/scripts/email-worker.ts",
    "automation:worker": "tsx apps/web/scripts/automation-worker.ts",
    "test:e2e:funnels": "playwright test --config=playwright.funnels.config.ts",
    "test:e2e:funnels-app": "tsx tests/support/start-funnel-app.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@mockoon/cli": "9.9.0",
    "@playwright/test": "^1.54.1",
    "tsx": "^4.23.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.16.0 <25"
  }
}
