  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  owner              User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions           FunnelVersion[] @relation("FunnelVersions")
  publishedVersion   FunnelVersion? @relation("FunnelPublication", fields: [publishedVersionId, id, ownerId, environment], references: [id, funnelId, ownerId, environment], onDelete: NoAction)
  journeys           FunnelJourney[]
  evidenceEffects    FunnelEvidenceEffect[]

  @@unique([id, ownerId, environment])
  @@index([ownerId, environment, status])
  automationEnrolmentEnabled Boolean @default(false)
  automationDispatchEnabled Boolean @default(false)
}

