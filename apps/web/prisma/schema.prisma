// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  GOOGLE
  META
  TIKTOK
  LINKEDIN
  X
}

model PlatformAccount {
  id          String   @id @default(cuid())
  platform    Platform
  externalId  String
  name        String?
  currency    String?
  timezone    String?
  accessToken String
  createdAt   DateTime @default(now())

  campaigns PlatformCampaign[]
}

model PlatformUserAccount {
  id          String   @id @default(cuid())
  platform    Platform
  userId      String
  externalId  String
  name        String?
  currency    String?
  timezone    String?
  accessToken String
  createdAt   DateTime @default(now())

  campaigns PlatformCampaign[]
  user      User               @relation(fields: [userId], references: [id])
}

model User {
  aiRequestWindows AiRequestWindow[]
  id           String   @id @default(cuid())
  email        String?
  name         String
  isBusiness   Boolean?
  loginEmail   String?  @unique
  passwordHash String?

  platformsAccounts PlatformUserAccount[]
  sessions          CustomerSession[]
  authorizations    ProviderAuthorization[]
  oauthAttempts     OAuthAttempt[]
  socialPosts       SocialPost[]
  socialMediaAssets SocialMediaAsset[]
  workspaceCampaigns WorkspaceCampaign[]
  brandKit BrandKit?
  socialEnqueues    SocialEnqueue[]
  metaPageCredentials MetaPageCredential[]
  trackingSources     TrackingSource[]
  funnelContacts      FunnelContact[]
  funnelIdentities    FunnelIdentity[]
  funnelSubjects      FunnelSubject[]
  funnelSubjectReferences FunnelSubjectReference[]
  trackingVisitors    TrackingVisitor[]
  trackingCorrelations TrackingCorrelation[]
  trackingEvents      TrackingEvent[]
  trackingFacts       TrackingFact[]
  trackingAudits      TrackingAudit[]
  trackingRateLimits  TrackingRateLimit[]
  trackingDeletions   TrackingDeletion[]
  funnels             Funnel[]
  funnelVersions      FunnelVersion[]
  funnelStages        FunnelStage[]
  funnelJourneys      FunnelJourney[]
  funnelStageTransitions FunnelStageTransition[]
  funnelPropertySnapshots FunnelPropertySnapshot[]
  funnelEvaluationReceipts FunnelEvaluationReceipt[]
  funnelEvidenceEffects FunnelEvidenceEffect[]
  funnelActionOutbox  FunnelActionOutbox[]
  emailConnectionRecords EmailConnection[]
  emailSenderRecords EmailSender[]
  marketingCampaignRecords MarketingCampaign[]
  campaignRevisionRecords CampaignRevision[]
  campaignStepRecords CampaignStep[]
  stageCampaignLinkRecords StageCampaignLink[]
  campaignMembershipRecords CampaignMembership[]
  campaignMembershipReasonRecords CampaignMembershipReason[]
  emailSubscriptionRecords EmailSubscription[]
  emailSuppressionRecords EmailSuppression[]
  emailPolicyAuditRecords EmailPolicyAudit[]
  messageSendRecords MessageSend[]
  messageSendAttributionRecords MessageSendAttribution[]
  deliveryAttemptRecords DeliveryAttempt[]
  emailDeliveryReceiptRecords EmailDeliveryReceipt[]
  emailUnsubscribeTokenRecords EmailUnsubscribeToken[]
  funnelActionExecutions FunnelActionExecution[]
  campaignStepExecutions CampaignStepExecution[]
}

model Asset {
  id         String   @id @default(cuid())
  name       String
  type       String
  contentUrl String?
  metadata   Json?
  source     String? // AI | USER_UPLOAD
  createdAt  DateTime @default(now())

  platformAssets PlatformAsset[]
  assetSets      AssetSetAsset[]
}

model PlatformAsset {
  id         String   @id @default(cuid())
  assetId    String
  platform   Platform
  externalId String

  asset Asset @relation(fields: [assetId], references: [id])
}

model AssetSet {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  assets AssetSetAsset[]
}

model AssetSetAsset {
  assetSetId String
  assetId    String

  assetSet AssetSet @relation(fields: [assetSetId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@id([assetSetId, assetId])
}

model Campaign {
  category  MarketingCategory @default(PAID_ADVERTISING)
  id        String            @id @default(cuid())
  name      String
  objective String
  status    String
  budget    Json
  targeting Json
  createdAt DateTime          @default(now())

  platformCampaigns PlatformCampaign[]
  adGroups          AdGroup[]
}

model PlatformCampaign {
  id         String   @id @default(cuid())
  campaignId String
  platform   Platform
  externalId String
  accountId  String

  campaign              Campaign             @relation(fields: [campaignId], references: [id])
  account               PlatformAccount      @relation(fields: [accountId], references: [id])
  platformUserAccount   PlatformUserAccount? @relation(fields: [platformUserAccountId], references: [id])
  platformUserAccountId String?
}

model AdGroup {
  id         String  @id @default(cuid())
  name       String
  campaignId String
  status     String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  ads      Ad[]
}

model Ad {
  id        String @id @default(cuid())
  adGroupId String
  type      String
  status    String

  adGroup     AdGroup      @relation(fields: [adGroupId], references: [id])
  platformAds PlatformAd[]
}

model PlatformAd {
  id         String   @id @default(cuid())
  adId       String
  platform   Platform
  externalId String

  ad Ad @relation(fields: [adId], references: [id])
}

model Audience {
  id         String   @id @default(cuid())
  type       String
  definition Json
  createdAt  DateTime @default(now())

  platformAudiences PlatformAudience[]
}

model PlatformAudience {
  id         String   @id @default(cuid())
  audienceId String
  platform   Platform
  externalId String

  audience Audience @relation(fields: [audienceId], references: [id])
}

model ConversionEvent {
  id        String   @id @default(cuid())
  event     String
  value     Float?
  currency  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model PerformanceMetric {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  platform   Platform

  impressions Int
  clicks      Int
  conversions Int
  cost        Float
  revenue     Float

  date DateTime
}

model ReachForecast {
  id                   String   @id @default(cuid())
  platform             Platform
  input                Json
  estimatedReach       Int
  estimatedImpressions Int
  createdAt            DateTime @default(now())
}

model AIAssetGeneration {
  id        String   @id @default(cuid())
  prompt    String
  outputUrl String
  type      String
  createdAt DateTime @default(now())
}

model AdProxyExecution {
  id              String    @id @default(cuid())
  operation       String
  source          String?
  requestPayload  Json
  responsePayload Json?
  success         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  ownerId         String?

  invocations AdPlatformInvocation[]
}

enum ConnectionCapability {
  ADS
  SOCIAL
}

enum AuthorizationStatus {
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
  REVOKED
}

enum DestinationKind {
  AD_ACCOUNT
  YOUTUBE_CHANNEL
  FACEBOOK_PAGE
  INSTAGRAM_PROFILE
  TIKTOK_PROFILE
  LINKEDIN_MEMBER
  LINKEDIN_ORGANIZATION
  X_PROFILE
}

enum ConnectionOperationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model CustomerSession {
  id            String         @id @default(cuid())
  userId        String
  tokenHash     String         @unique
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAttempts OAuthAttempt[]

  @@index([userId])
}

model LoginAttempt {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
}

model OAuthAttempt {
  id                       String               @id @default(cuid())
  stateHash                String               @unique
  userId                   String
  sessionId                String
  provider                 Platform
  capability               ConnectionCapability
  redirectUri              String
  requestedScopes          Json
  reconnectAuthorizationId String?
  exchangeClaimHash        String?
  verifierCiphertext       String?
  expiresAt                DateTime
  consumedAt               DateTime?
  createdAt                DateTime             @default(now())
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  session                  CustomerSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ProviderAuthorization {
  id                String                  @id @default(cuid())
  userId            String
  provider          Platform
  providerUserId    String
  capability        ConnectionCapability
  externalGrantId   String?
  connectionMode    String                  @default("LEGACY")
  authorizedAt      DateTime?
  accessCiphertext  String?
  refreshCiphertext String?
  expiresAt         DateTime?
  refreshExpiresAt  DateTime?
  scopes            Json
  status            AuthorizationStatus     @default(CONNECTED)
  generation        Int                     @default(1)
  credentialVersion Int                     @default(1)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  disconnectedAt    DateTime?
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations      ConnectionDestination[]
  events            ConnectionAuditEvent[]
  metaPageCredentials MetaPageCredential[]
  renewalLease      SocialCredentialRenewalLease?

  @@unique([userId, provider, providerUserId, capability])
  @@index([userId, status])
  @@index([provider, externalGrantId])
}

model ConnectionDestination {
  id                 String                @id @default(cuid())
  authorizationId    String
  externalId         String
  kind               DestinationKind
  name               String?
  currency           String?
  timezone           String?
  selected           Boolean               @default(false)
  available          Boolean               @default(true)
  metadata           Json?
  selectedContext    Json?
  lastCheckedAt      DateTime?
  authorization      ProviderAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  operations         ConnectionOperation[]
  socialPostVariants SocialPostVariant[]
  socialDeliveries   SocialDelivery[]

  @@unique([authorizationId, kind, externalId])
}

model ConnectionOperation {
  id             String                    @id @default(cuid())
  destinationId  String
  generation     Int
  requiredScopes Json
  status         ConnectionOperationStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?
  destination    ConnectionDestination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, status])
}

model ConnectionAuditEvent {
  id              String                @id @default(cuid())
  authorizationId String
  action          String
  createdAt       DateTime              @default(now())
  authorization   ProviderAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
}

model AdPlatformInvocation {
  id                 String    @id @default(cuid())
  executionId        String
  authorizationId    String?
  destinationId      String?
  connectionMode     String    @default("LEGACY")
  platform           Platform
  adapterPayload     Json
  downstreamPath     String?
  downstreamRequest  Json?
  downstreamResponse Json?
  success            Boolean?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  execution AdProxyExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([authorizationId, connectionMode])
}

model ProviderRevocationFence {
  id             String   @id @default(cuid())
  provider       Platform
  connectionMode String
  subjectDigest  String
  revokedAt      DateTime

  @@unique([provider, connectionMode, subjectDigest])
}

model ProviderLifecycleEvent {
  id             String   @id
  provider       Platform
  connectionMode String
  subjectDigest  String
  action         String
  receivedAt     DateTime @default(now())
  receiptId      String?
}

model ProviderDeletionReceipt {
  id             String    @id
  provider       Platform
  connectionMode String
  status         String    @default("PENDING")
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?
}

enum MarketingCategory {
  PAID_ADVERTISING
  SOCIAL_PUBLISHING
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SocialMediaStatus {
  PENDING
  AVAILABLE
  REJECTED
  DELETED
}

enum SocialMediaType {
  IMAGE
  VIDEO
}

enum SocialDeliveryStatus {
  QUEUED
  LEASED
  RETRY_WAIT
  SUCCEEDED
  FAILED
  BLOCKED
  UNCERTAIN
  CANCELLED
  SUPERSEDED
}

enum SocialDeliveryPhase {
  PREPARE
  UPLOAD
  PROCESS
  PUBLISH
  COMPLETE
}

model SocialPost {
  id              String               @id @default(cuid())
  ownerId         String
  category        MarketingCategory    @default(SOCIAL_PUBLISHING)
  title           String
  currentRevision Int                  @default(1)
  generation      Int                  @default(1)
  status          SocialPostStatus     @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revisions       SocialPostRevision[]
  deliveries      SocialDelivery[]
  enqueues        SocialEnqueue[]

  @@index([ownerId, updatedAt])
}

model SocialPostRevision {
  id                   String                @id @default(cuid())
  postId               String
  number               Int
  title                String
  body                 String
  contentDigest        String
  reviewedAt           DateTime?
  reviewedById         String?
  approvedDestinations Json?
  createdAt            DateTime              @default(now())
  post                 SocialPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  variants             SocialPostVariant[]
  media                SocialRevisionMedia[]
  deliveries           SocialDelivery[]
  enqueues             SocialEnqueue[]

  @@unique([postId, number])
}

model SocialMediaAsset {
  id         String                @id @default(cuid())
  ownerId    String
  storageKey String                @unique
  digest     String
  bytes      Int
  mime       String
  type       SocialMediaType
  width      Int
  height     Int
  durationMs Int?
  expiresAt  DateTime?
  status     SocialMediaStatus     @default(PENDING)
  verifiedAt DateTime?
  filename   String?
  metadata   Json?
  createdAt  DateTime              @default(now())
  owner      User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revisions  SocialRevisionMedia[]

  @@index([ownerId, status])
}

model SocialRevisionMedia {
  revisionId String
  mediaId    String
  position   Int
  revision   SocialPostRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      SocialMediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([revisionId, mediaId])
  @@unique([revisionId, position])
}

model SocialPostVariant {
  id              String                @id @default(cuid())
  revisionId      String
  destinationId   String
  format          String
  title           String?
  body            String
  mediaIds        Json
  providerOptions Json                  @default("{}")
  revision        SocialPostRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  destination     ConnectionDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  deliveries      SocialDelivery[]

  @@unique([revisionId, destinationId])
}

model SocialEnqueue {
  id             String             @id @default(cuid())
  ownerId        String
  key            String
  postId         String
  revisionId     String
  requestDigest  String
  dueAt          DateTime
  timeZone       String
  destinationIds Json
  createdAt      DateTime           @default(now())
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post           SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  revision       SocialPostRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  deliveries     SocialDelivery[]

  @@unique([ownerId, key])
}

model SocialDelivery {
  id                      String                  @id @default(cuid())
  postId                  String
  revisionId              String
  variantId               String
  destinationId           String
  enqueueId               String
  authorizationId         String
  authorizationGeneration Int
  postGeneration          Int
  connectionMode          String
  requiredScopes          Json
  dueAt                   DateTime
  timeZone                String
  status                  SocialDeliveryStatus    @default(QUEUED)
  phase                   SocialDeliveryPhase     @default(PREPARE)
  leaseTokenHash          String?
  leaseUntil              DateTime?
  attempts                Int                     @default(0)
  nextAttemptAt           DateTime?
  publishStartedAt        DateTime?
  externalId              String?
  publishUrl              String?
  errorCode               String?
  cancellationRequested   Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  completedAt             DateTime?
  post                    SocialPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  revision                SocialPostRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  variant                 SocialPostVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  destination             ConnectionDestination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  enqueue                 SocialEnqueue           @relation(fields: [enqueueId], references: [id], onDelete: Cascade)
  deliveryAttempts        SocialDeliveryAttempt[]
  progress                SocialDeliveryProgress?

  @@unique([revisionId, destinationId])
  @@index([status, dueAt, nextAttemptAt])
  @@index([authorizationId, connectionMode])
}

model SocialDeliveryAttempt {
  id         String         @id @default(cuid())
  deliveryId String
  number     Int
  leaseHash  String
  status     String         @default("RUNNING")
  errorCode  String?
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  delivery   SocialDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, number])
}

model SocialDeliveryProgress {
  deliveryId     String         @id
  encryptedState String
  version        Int            @default(1)
  updatedAt      DateTime       @updatedAt
  delivery       SocialDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// Private SOCIAL Page tokens; public connection DTOs never include this relation.
model MetaPageCredential {
  authorizationId String
  pageId String
  ownerId String
  connectionMode String
  authorizationGeneration Int
  credentialVersion Int
  accessCiphertext String
  version Int @default(1)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorization ProviderAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([authorizationId, pageId])
  @@index([ownerId, connectionMode])
}

// Estimated API allocations, never claims of actual provider bills. Retained when a draft/job is deleted.
model SocialApiBudgetWindow {
  ownerId        String
  provider       Platform
  connectionMode String
  windowStart    DateTime
  reservedMicros BigInt                     @default(0)
  createdAt      DateTime                   @default(now())
  reservations   SocialApiCostReservation[]

  @@id([ownerId, provider, connectionMode, windowStart])
}

model SocialApiCostReservation {
  id                      String                @id
  ownerId                 String
  provider                Platform
  connectionMode          String
  windowStart             DateTime
  kind                    String                @default("DELIVERY")
  deliveryId              String?
  revisionId              String?
  authorizationId         String?
  authorizationGeneration Int?
  credentialVersion       Int?
  leaseHash               String?
  connectionApprovalId    String?
  operation               String
  costMicros              BigInt
  reviewedCapMicros       BigInt
  createdAt               DateTime              @default(now())
  window                  SocialApiBudgetWindow @relation(fields: [ownerId, provider, connectionMode, windowStart], references: [ownerId, provider, connectionMode, windowStart], onDelete: Restrict)
  connectionApproval      XConnectionCostApproval? @relation(fields: [connectionApprovalId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([ownerId, provider, connectionMode, createdAt])
  @@index([connectionApprovalId])
}

// Private, explicit session-owned approval for one OAuth or account-check operation.
model XConnectionCostApproval {
  id                      String   @id
  kind                    String
  ownerId                 String
  sessionId               String
  connectionMode          String
  stateHash               String?  @unique
  oauthAttemptId          String?  @unique
  authorizationId         String?
  authorizationGeneration Int?
  credentialVersion       Int?
  capMicros               BigInt
  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime @default(now())
  reservations            SocialApiCostReservation[]

  @@index([ownerId, sessionId, expiresAt])
}

// Private rotating-refresh coordination; contains no access/refresh token plaintext.
model SocialCredentialRenewalLease {
  authorizationId         String @id
  ownerId                 String
  provider                Platform
  connectionMode          String
  authorizationGeneration Int
  credentialVersion       Int
  refreshDigest           String
  leaseTokenHash          String
  leaseUntil              DateTime
  startedAt               DateTime?
  requestCount            Int @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  authorization           ProviderAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@index([leaseUntil])
}

// Customer-owned planning records. Execution remains in the existing provider services.
model WorkspaceCampaign {
  id String @id @default(cuid())
  ownerId String
  type String
  name String
  websiteUrl String @default("")
  brief String @default("")
  goal String @default("")
  audience String @default("")
  platforms Json @default("[]")
  plan Json @default("{}")
  creatives Json @default("[]")
  socialPostIds Json @default("[]")
  status String @default("DRAFT")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
}

model BrandKit {
  ownerId String @id
  name String @default("")
  websiteUrl String @default("")
  voice String @default("")
  audience String @default("")
  colors Json @default("[]")
  rules String @default("")
  logoUrl String @default("")
  version Int @default(1)
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model AiRequestWindow {
  key String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count Int @default(0)
  @@index([ownerId, windowStart])
}

// Tracking identities are separate from customer logins and advertising accounts.
// Migration CHECKs and immutable-identity triggers enforce the string contracts.
model TrackingSource {
  id                   String   @id @default(cuid())
  ownerId              String
  environment          String
  provider             String
  externalAccountId    String
  name                 String
  config               Json
  credentialCiphertext String?
  ingressTokenHash     String   @unique
  status               String   @default("ACTIVE")
  generation           Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  owner                User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  identities           FunnelIdentity[]
  subjectReferences    FunnelSubjectReference[]
  visitors             TrackingVisitor[]
  correlations         TrackingCorrelation[]
  events               TrackingEvent[]
  audits               TrackingAudit[]
  rateLimits           TrackingRateLimit[]
  deletions            TrackingDeletion[]
  propertySnapshots    FunnelPropertySnapshot[]

  @@unique([id, ownerId, environment])
  @@unique([ownerId, environment, provider, externalAccountId])
  @@index([ownerId, environment, status])
  emailConnection EmailConnection?
  emailPolicyAudits EmailPolicyAudit[]
  @@unique([id, provider, ownerId, environment])
  waitingSteps CampaignStepExecution[]
}

model FunnelContact {
  id          String   @id @default(cuid())
  ownerId     String
  environment String
  email       String?
  name        String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  identities  FunnelIdentity[]
  subjects    FunnelSubject[]
  events      TrackingEvent[]

  @@unique([id, ownerId, environment])
  @@index([ownerId, environment, email])
  campaignMemberships CampaignMembership[]
  messageSends MessageSend[]
}

model FunnelIdentity {
  id          String @id @default(cuid())
  ownerId     String
  environment String
  sourceId    String
  namespace   String
  externalId  String
  contactId   String
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source      TrackingSource @relation(fields: [sourceId, ownerId, environment], references: [id, ownerId, environment], onDelete: Cascade)
  contact     FunnelContact @relation(fields: [contactId, ownerId, environment], references: [id, ownerId, environment], onDelete: Cascade)

  @@unique([ownerId, sourceId, namespace, externalId])
  @@index([contactId, ownerId, environment])
}

model FunnelSubject {
  id             String @id @default(cuid())
  ownerId        String
  environment    String
  kind           String
  contactId      String?
  createdAt      DateTime @default(now())
  lastOccurredAt DateTime?
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contact        FunnelContact? @relation(fields: [contactId, ownerId, environment], references: [id, ownerId, environment], onDelete: NoAction)
  references     FunnelSubjectReference[]
  correlations   TrackingCorrelation[]
  events         TrackingEvent[]
  facts          TrackingFact[]
  journeys       FunnelJourney[]
  propertySnapshots FunnelPropertySnapshot[]
  evaluationReceipts FunnelEvaluationReceipt[]
  evidenceEffects FunnelEvidenceEffect[]

  @@unique([id, ownerId, environment])
  @@index([ownerId, environment, kind, contactId])
