// Funnel definitions are editable drafts; published versions and stages are immutable.
// Migration-only constraints enforce environment isolation, active journey uniqueness,
// append-only history, and command/evidence tombstones independently of the service.
model Funnel {
  id                 String @id @default(cuid())
  ownerId            String
  environment        String
  name               String
  subjectKind        String
  draft              Json
  draftRevision      Int @default(1)
  publishedVersionId String?
