TEST_ENV=local
BASE_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:3000/api
AUTH_STORAGE_STATE=tests/.auth/anonymous.json

# Shared customer/session foundation (server-only settings).
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=file:./prisma/dev.db
ADS_MODE=mock
# Generate random 32-byte keys and install them in the secret store.
# Example shape only: {"v1":"<canonical base64 key>"}
CONNECTION_TOKEN_KEYS=
CONNECTION_ACTIVE_KEY_ID=v1

# External provider connection mode: disabled, mock, or live. No fallback.
CONNECTION_MODE=mock
GOOGLE_ADS_MOCKOON_URL=http://127.0.0.1:3910
# Required only in live mode; use the Cloud project approved for Google Ads access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Ads Business Login (USER token configuration), server-only.
META_ADS_MOCKOON_URL=http://127.0.0.1:3911
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
META_MARKETING_VERSION=v26.0

# Optional read-only pilot CLI: explicit local destination allowlist; never provider tokens.
ADS_PILOT_ALLOWLIST=[]
