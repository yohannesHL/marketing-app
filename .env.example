TEST_ENV=local
BASE_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:3000/api
AUTH_STORAGE_STATE=tests/.auth/anonymous.json

# Shared customer/session foundation (server-only settings).
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=file:./prisma/dev.db
ADS_MODE=mock
# Generate random 32-byte keys and install them in the secret store.
# Example shape only: {"v1":"<canonical base64 key>"}
CONNECTION_TOKEN_KEYS=
CONNECTION_ACTIVE_KEY_ID=v1

# External provider connection mode: disabled, mock, or live. No fallback.
CONNECTION_MODE=mock
GOOGLE_ADS_MOCKOON_URL=http://127.0.0.1:3910
# Required only in live mode; use the Cloud project approved for Google Ads access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Ads Business Login (USER token configuration), server-only.
META_ADS_MOCKOON_URL=http://127.0.0.1:3911
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
META_MARKETING_VERSION=v26.0

# Optional read-only pilot CLI: explicit local destination allowlist; never provider tokens.
ADS_PILOT_ALLOWLIST=[]

# Social media requires a persistent private volume and FFmpeg/ffprobe runtime.
SOCIAL_PUBLISHING_ENABLED=false
# Exact platform:destination-kind allowlist; connection readiness alone is not publication approval.
SOCIAL_APPROVED_PROVIDERS=[]
# HTTPS origin must be reachable by providers; TikTok requires verified ownership.
SOCIAL_MEDIA_DIRECTORY=
SOCIAL_MEDIA_PUBLIC_ORIGIN=
SOCIAL_MEDIA_SIGNING_KEY=
# Optional: app upload cap (64 MiB default, maximum 512 MiB; platform limits also apply).
SOCIAL_MEDIA_MAX_BYTES=67108864
# Optional: executable path; default is ffprobe on PATH.
SOCIAL_FFPROBE_PATH=

# YouTube Shorts uses separate Google SOCIAL consent and offline access.
YOUTUBE_MOCKOON_URL=http://127.0.0.1:3912
# Required only in live mode; enable YouTube Data API in this OAuth project.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Separate Meta organic publishing Business Login configuration (USER tokens).
# Shares META_APP_ID/SECRET with Ads and signed lifecycle callbacks; scopes/config differ.
META_PUBLISHING_MOCKOON_URL=http://127.0.0.1:3913
META_PUBLISHING_CONFIG_ID=

# TikTok Direct Post: approved Login Kit/Content Posting API app, separate SOCIAL consent.
TIKTOK_MOCKOON_URL=http://127.0.0.1:3914
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Exact owned HTTPS media prefix verified with TikTok; local loopback only in explicit mock mode.
TIKTOK_VERIFIED_MEDIA_PREFIX=
# Record actual audit approval before setting true; this flag does not prove approval.
TIKTOK_APP_AUDITED=false

# LinkedIn approved Community Management/Sign In products, independent of Ads.
LINKEDIN_MOCKOON_URL=http://127.0.0.1:3915
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Exact approved scope whitelist; default [] intentionally leaves LinkedIn disabled.
# Member reconciliation additionally needs restricted r_member_social; ordinary w_member_social is insufficient.
LINKEDIN_SCOPES=[]
# Set only after actual Marketing Developer Platform programmatic-refresh approval.
LINKEDIN_MDP_REFRESH_ENABLED=false
